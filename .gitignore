.venv/
__pycache__/
*.pyc
__pycache__/
*.pyc
.pytest_cache/

# Per-run connector outputs: regenerable, churn on every run, would bloat history.
# Evaluation sets (data/eval) and probe evidence (data/probes) stay versioned.
data/snapshots/
data/normalized/
data/runs/
data/held/
data/events/
data/quarantine/

# Local dev store built by web/dev_up.py
web/.data/

# Private keys never enter the repository; generate with infra/scripts/bootstrap_age_key.sh
infra/sops/keys/*.txt
.coverage

# Harness-managed isolated worktrees for review agents (never repository content)
.claude/worktrees/

# Developer-local fixtures that must never be committed: documents from a `reuse: unknown` source
# (e.g. the RRC Class VI list PDFs read by pipeline/connectors/us_tx_rrc_class_vi's skipif test).
tests/fixtures/local/
