# Copy to terraform.tfvars (git-ignored) and fill in. No secrets belong here — credentials come
# from HCLOUD_TOKEN / CLOUDFLARE_API_TOKEN environment variables (see variables.tf header).

environment            = "dev"
domain                 = "example-infraque.test"   # infraque.com until the owner names the product
cloudflare_zone_id     = ""                          # leave blank until the domain is registered
cloudflare_account_id  = ""                          # leave blank to skip R2 bucket creation
ssh_public_key         = "ssh-ed25519 AAAA...replace-with-the-operator-key... deploy@infraque"
vm_count_workers       = 1
# Firewall (docs/60 §2; both default to anyone, the previous rules):
# ssh_source_cidrs     = ["203.0.113.7/32"]      # the operator's address
# web_source_cidrs     = ["cloudflare"]          # only once Cloudflare proxies the site
