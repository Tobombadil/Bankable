# Copy to .env (git-ignored) for local Compose runs, or decrypt the real per-environment file from
# infra/sops/secrets.<env>.enc.yaml onto the VM at deploy time (infra/scripts/deploy.sh). Never
# commit a filled-in .env (docs/04 E-19).
#
# This ONE file is both the Compose interpolation source (`--env-file`) and every service's
# `env_file:` (infra/compose/docker-compose.yml `x-env-file`), so every key below reaches every
# container. INFRAQUE_ENV_FILE is the path Compose reads it from: unset means infra/compose/.env
# (dev); deploy.sh sets /opt/infraque/secrets/.env on the VMs.

ENVIRONMENT=dev
DOMAIN=example-infraque.test
LOG_LEVEL=info

# Image tag every service runs (.github/workflows/release.yml pushes `sha-<short sha>` on every
# push to main and `latest` for the newest main build); deploy.sh takes it as its argument.
IMAGE_TAG=latest

# Signs session cookies and email-verification tokens (services/api/auth.py). Any ENVIRONMENT
# other than dev/development/local/test/ci refuses to start unless this is set and >= 32 chars;
# generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`, never reuse across
# environments, rotate per docs/60 §10.5.
SESSION_SECRET=

# local-profile Postgres only; staging/production set DATABASE_URL to the managed provider's
# connection string instead and never start the `postgres` service (ADR 0003).
POSTGRES_PASSWORD=infraque-dev-only
DATABASE_URL=postgresql+psycopg://infraque:infraque-dev-only@postgres:5432/infraque

# Object storage (Cloudflare R2, S3-compatible; docs/20 §4.4)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Observability (docs/20 §10). SENTRY_DSN set => infra/observability.py initialises error
# tracking in every process (api, web, worker, browser-worker, scheduler); unset => no-op.
SENTRY_DSN=
GRAFANA_CLOUD_API_KEY=

# Backups (infra/scripts/backup.sh, nightly via the systemd timer in
# infra/terraform/cloud-init/app.yaml). Local dumps kept BACKUP_RETENTION_DAYS (docs/60 §8: 35);
# R2 keeps 14 daily plus 8 weekly (Sunday) dumps.
BACKUP_RETENTION_DAYS=35

# Model gateway (docs/20 §4.5) — provider key lives here; aliases only ever appear in code/logs
MODEL_PROVIDER_API_KEY=

# Map basemap tiles (docs/40 §2.7; docs/adr/0007). Three modes, in order of preference:
#   1. A self-hosted PMTiles URL, e.g. https://tiles.example-infraque.test/basemap.pmtiles
#      (infra/scripts/build_basemap.sh + .github/workflows/basemap.yml build and refresh this).
#   2. A raster tile template from a hosted provider (MapTiler/Stadia), e.g.
#      https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=...
#   3. Unset: the map falls back to tile.openstreetmap.org, which is dev-only — its usage policy
#      forbids production apps (docs/40 §2.7) and this must never be unset in staging/production.
MAP_TILE_URL=

# Service identity for the web app's server-side calls to the API: same value on both, random, never
# reused across environments. Requests carrying it skip the anonymous per-IP rate-limit bucket.
API_INTERNAL_TOKEN=

# Sender identity for every alert/digest email (CAN-SPAM physical address; docs/13 outreach §2).
# Refused (email counted, not sent) when either is unset and ENVIRONMENT=production. Owner values
# recorded in docs/00-PLAN.md decisions log 2026-09-18; the .env on the host carries them, not git.
SENDER_LEGAL_NAME=
SENDER_POSTAL_ADDRESS=

# Product identity used in the automation disclosure and email footers (services/social/editorial.py).
PRODUCT_NAME=Infraque
PRODUCT_URL=https://infraque.com
PRODUCT_CONTACT_EMAIL=hello@infraque.com

# Pepper for the one-way hash of erased identifiers in the audit log (services/api/audit.py).
# Required in production; a low-entropy dev fallback applies elsewhere. Rotate = old hashes unmatchable.
AUDIT_HASH_PEPPER=

# Platform posture (owner decision 2026-09-25; docs/26-platform-posture.md). `commercial` (the code's own
# default when this is unset or unrecognised) publishes `open`/`attribution` sources only; `noncommercial`
# additionally publishes sources whose terms grant noncommercial reuse, with attribution. Read once per
# process by the api, the ingest runner and the workers: change it, then restart all three.
#
# Set to `noncommercial` 2026-09-26 (docs/26 §6, "The flip"): precondition (i) — the paid surfaces (pricing
# page, checkout, pro/api entitlements) suspended or plainly marked inactive while this posture is claimed —
# is delivered in code: under `noncommercial` the pricing page marks paid tiers inactive and both checkout
# routes refuse (docs/26 §3(i)). Precondition (ii) — counsel confirming this entity can hold noncommercial
# status — was withdrawn by the owner on 2026-09-26 (docs/00-PLAN.md decisions log, "Seven owner decisions";
# docs/26 §3(ii); the open recommendation stays as docs/13 §7 item 15). This file is a template: copying it to
# a live `.env` is what actually turns this on for that environment (docs/60 §5.1); an existing `.env` is not
# changed by editing this file.
PLATFORM_POSTURE=noncommercial
