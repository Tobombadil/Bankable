# Caddy terminates TLS with automatic Let's Encrypt certificates (docs/20 §11, ADR 0005). Cloudflare
# (proxied DNS) sits in front of it at the edge (docs/20 §2); Caddy still needs a real certificate
# because Cloudflare's edge connects to the origin over HTTPS ("Full (strict)" SSL mode, docs/60).
#
# Two environment variables, both required (compose.prod.yml refuses to render without them and
# `caddy adapt` fails on either missing, so a bad env file stops here, not at the first request):
#   DOMAIN       the registered apex, e.g. infraque.com (the same value in staging and production)
#   ENVIRONMENT  staging | production; picks the host set below, which matches the Cloudflare
#                records in infra/terraform/dns.tf:
#                  production  {DOMAIN}          admin.{DOMAIN}          api.{DOMAIN}          www.{DOMAIN} -> apex
#                  staging     staging.{DOMAIN}  admin-staging.{DOMAIN}  api-staging.{DOMAIN}  (no www record)
#
# Routing (devops audit 2026-09-30 F2, architect A7, PM-3). The API owns four path prefixes; every
# other path is the web app:
#   /v1/*  /feeds/*  /webhooks/*   -> api:8000 (site and api hosts)
#   /admin/v1/*                    -> api:8000 (admin host only)
#   everything else                -> web:8001
# Admin lives on the admin host alone (2026-10-10, docs/51 §2.4 item 5; D-16): it serves the web
# app, the operator UI at /admin/<page> included (its pages call the API server-side with the
# operator's cookie, web/admin/shell.py), plus /admin/v1/*; its root redirects to /admin. The site
# and api hosts answer 404 for /admin, /admin/* and /admin/v1/* (`no_admin`). The api host is the
# API alone: it is the server in api/openapi.yaml, the Attio webhook target and the host of
# download, unsubscribe and problem-type URLs (services/api/common.py API_HOST).
# infra/test_caddyfile.py proves each route with a real Caddy and checks the API prefixes against
# the API's own route table.
#
# Client address (devops audit F1, architect A3). Caddy believes CF-Connecting-IP only from a peer
# in Cloudflare's published ranges (below) and then sends the upstream exactly one address in
# X-Forwarded-For: `{client_ip}`, which is that header's value from Cloudflare and the real peer
# for anyone else. Whatever X-Forwarded-For a client sent is overwritten, not appended to, so
# uvicorn (which believes X-Forwarded-For from Caddy's address only, infra/entrypoint.py) sees
# the visitor and nothing a visitor can forge. X-Internal-Token and X-Visitor-IP are internal to
# the Compose network (web -> api) and are stripped from every inbound request.
{
	servers {
		# Cloudflare's published edge ranges, vendored from https://www.cloudflare.com/ips-v4 and
		# https://www.cloudflare.com/ips-v6 (the same lists as https://api.cloudflare.com/client/v4/ips,
		# etag 38f79d050aa027e3be3865e495dcc9bc), retrieved 2026-09-30. Cloudflare changes these
		# rarely and announces changes in advance; re-check at every quarterly secret rotation
		# (docs/60 §10.5) and update here and in infra/test_caddyfile.py together.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(to_api) {
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

(to_web) {
	reverse_proxy web:8001 {
		header_up X-Forwarded-For {client_ip}
	}
}

# Who may reach the site (docs/64). `SITE_ACCESS` unset or `open`: everyone, as production
# serves. `basic` (the private beta): every request needs the one shared login, the browser's
# own password prompt, except `/webhooks/*` (Stripe and Attio carry their own signatures and
# cannot answer a prompt) and the health checks. Gated answers are `private, no-store` and
# `noindex`, so neither an edge cache nor a search engine keeps a copy. SITE_ACCESS_HASH is
# `caddy hash-password`'s bcrypt hash, base64-encoded so no `$` meets the env file's
# interpolation; deploy.sh refuses `basic` without both values.
(gate_open) {
}

(gate_basic) {
	@gated not path /webhooks/* /health /v1/health
	basic_auth @gated {
		{$SITE_ACCESS_USER} {$SITE_ACCESS_HASH}
	}
	# The beta login is Caddy's, not the API's: never forward it, or the API would read it as a
	# credential (it reads `Authorization` for API keys). Runs after basic_auth (Caddy's order).
	request_header @gated -Authorization
	header @gated {
		>Cache-Control "private, no-store"
		X-Robots-Tag "noindex, nofollow"
	}
}

# Response headers on every host (2026-10-10, docs/51 §2.4 item 5). `?` writes a header only when
# the upstream sent none, so a page can still send a stricter value of its own. They go on every
# response a handler writes (pages, API answers, redirects, the admin 404); Caddy's own error
# responses (the gate's 401, a 502 while an upstream is down) carry none, and have no body to protect.
# - HSTS: every host set below (production, staging) serves Let's Encrypt certificates; local and
#   dev run no Caddy (the base Compose file has none, and any other ENVIRONMENT fails to adapt).
#   One year; no includeSubDomains and no preload, which would bind every other name under DOMAIN
#   and cannot be undone quickly. A rehearsal on `localhost` sends it too: probe with curl, not the
#   browser you develop in.
# - frame-ancestors 'none' is enforced, alone in its own policy, so it restricts nothing else.
# - The full policy is Report-Only: the browser reports what it would block (in its console; there
#   is no report endpoint yet) and blocks nothing. It allows the site as it is on 2026-10-10:
#     scripts   self, the three CDN packages web/assets.py pins (SRI-checked), Cloudflare Turnstile
#               (/submit and the report-a-problem form), and the one inline script, base.html's
#               `document.documentElement.classList.add("js")`, by hash;
#     styles    self, MapLibre's stylesheet, and 'unsafe-inline' for the templates' style attributes;
#     images    self, data: and blob: (MapLibre), the Protomaps sprites, the basemap file;
#     fetches   self, the basemap file (MAP_TILE_URL, a PMTiles URL in production: a valid source
#               that matches exactly that file) and the Protomaps glyphs and sprites;
#     fonts     self (web/static/fonts; no Google Fonts); workers self and blob: (MapLibre);
#     frames    Turnstile only.
#   infra/test_caddyfile.py derives the CDN packages, the Turnstile origin and the inline-script
#   hashes from web/ and fails when the policy no longer matches the site.
(security_headers) {
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Content-Security-Policy "frame-ancestors 'none'"
		?Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/ https://cdn.jsdelivr.net/npm/pmtiles@4.5.0/ https://cdn.jsdelivr.net/npm/@protomaps/basemaps@5.7.2/ https://challenges.cloudflare.com 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U='; style-src 'self' https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/ 'unsafe-inline'; img-src 'self' data: blob: https://protomaps.github.io/basemaps-assets/ {$MAP_TILE_URL}; connect-src 'self' https://protomaps.github.io/basemaps-assets/ {$MAP_TILE_URL}; font-src 'self'; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'"
	}
}

(common) {
	import security_headers
	import gate_{$SITE_ACCESS:open}
	request_header -X-Internal-Token
	request_header -X-Visitor-IP
	encode gzip
	log {
		output stdout
		format json
	}
}

# Admin is the admin host's alone (routing note at the top). On the site and api hosts every admin
# path is a 404 before any upstream sees it; behind the beta gate the login is asked for first.
(no_admin) {
	@admin path /admin /admin/*
	handle @admin {
		respond 404
	}
}

(site) {
	import common
	import no_admin
	@api path /v1/* /feeds/* /webhooks/*
	handle @api {
		import to_api
	}
	handle {
		import to_web
	}
}

(admin_site) {
	import common
	handle /admin/v1/* {
		import to_api
	}
	handle / {
		redir * /admin 302
	}
	handle {
		import to_web
	}
}

(api_site) {
	import common
	import no_admin
	handle {
		import to_api
	}
}

(hosts_production) {
	{$DOMAIN} {
		import site
	}
	admin.{$DOMAIN} {
		import admin_site
	}
	api.{$DOMAIN} {
		import api_site
	}
	www.{$DOMAIN} {
		import security_headers
		redir https://{$DOMAIN}{uri} permanent
	}
}

(hosts_staging) {
	staging.{$DOMAIN} {
		import site
	}
	admin-staging.{$DOMAIN} {
		import admin_site
	}
	api-staging.{$DOMAIN} {
		import api_site
	}
}

import hosts_{$ENVIRONMENT}
